# GitHub App Configuration
GITHUB_APP_CLIENT_ID=Iv1.your_client_id_here
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_APP_REPOSITORY=owner/repo
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret

# Tempus executor (mediated writes)
TEMPUS_GATE_ID=gate_public_key_hex
TEMPUS_TENANT_ID=tenant_id_string
TEMPUS_EXECUTOR_DB=executor.db
TEMPUS_EXECUTOR_KEYFILE=executor.keys.json
# github.push_branch: the agent's git bundle and the namespace it may push to
# TEMPUS_BUNDLE=agent.bundle
# TEMPUS_PUSH_BRANCH_PREFIX=agent/

# Tempus Guard (close the trace, export the evidence bundle, publish the check run).
# Both TEMPUS_GATE_DB and TEMPUS_GATE_KEYFILE enable the Guard flow; without them the
# executor only consumes the permit and prints the signed outcome.
# TEMPUS_GATE_DB=gate.db
# TEMPUS_GATE_KEYFILE=gate.keys.json
# TEMPUS_CHECK_NAME=Verified by Tempus
# TEMPUS_NO_CHECK_RUN=0
# TEMPUS_BUNDLE_OUT=evidence/bundle.json
# TEMPUS_MAX_STREAM_EVENTS=10000
